# Database (SQLite by default for local MVP; swap to a Postgres URL in production)
DATABASE_URL="file:./dev.db"

# Auth
JWT_SECRET="change-this-to-a-long-random-string"

# Restaurant location (used for the delivery-radius / Haversine check)
RESTAURANT_NAME="Pratha Restaurant"
RESTAURANT_LAT="28.6139"
RESTAURANT_LNG="77.2090"
RESTAURANT_DELIVERY_RADIUS_KM="6"
RESTAURANT_WHATSAPP_NUMBER="+919876543210"

# Public base URL (used to build the QR code target link)
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Razorpay (leave blank to disable online payments; COD still works without these)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# Twilio WhatsApp (leave blank to disable — new-order alerts are just logged to the console instead)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM=""
